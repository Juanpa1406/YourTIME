# Supabase project credentials
# Copy this file to .env.local and fill in real values.
# NEVER commit .env.local — only .env.example is allowed in git.

VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_ANON_PUBLIC_KEY

# IMPORTANT: never put the SERVICE_ROLE_KEY here.
# The service-role key is server-only and must NEVER ship to the React bundle.
